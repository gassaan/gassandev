# Copy to .env.local for local development. Leave both unset to run against
# browser storage instead — the app falls back automatically.
#
# Find these in the Supabase dashboard under Project Settings → API.
#
# VITE_SUPABASE_ANON_KEY takes the key the dashboard now labels "publishable"
# (sb_publishable_...); anon is the older name for the same thing. It is meant
# to be public and is compiled into the client bundle, so row level security
# (supabase/schema.sql) is what actually protects the data.
#
# Never put the "secret" key (sb_secret_..., formerly service_role) here — it
# bypasses RLS entirely.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
